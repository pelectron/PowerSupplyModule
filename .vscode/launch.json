{
  "version": "0.2.0",
  "configurations": [
    {
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/software/main.elf",
      "name": "Debug with JLink",
      "request": "launch",
      "type": "cortex-debug",
      "device": "stm32c031k4",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none",
      "servertype": "jlink"
    },
    {
      "name": "cli-test",
      "type": "codelldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/software/cli-test.exe",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": true
    },
    {
      "name": "unit-test",
      "type": "codelldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/software/unit-test.exe",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": true
    },
    {
      "name": "main",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/software/main.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "stopAtEntry": false,
      "miDebuggerPath": "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/13.2 rel1/bin/arm-none-eabi-gdb.exe",
      "hardwareBreakpoints": {
        "require": true,
        "max": 4
      },
      "debugServerPath": "C:/Program Files/SEGGER/JLink/JLinkGDBServerCL.exe",
      "debugServerArgs": "-If SWD -Speed 800 -Device STM32C031K4 -s",
      "miDebuggerServerAddress": "localhost:2331",
      "customLaunchSetupCommands": [
        {
          "text": "set architecture auto"
        },
        {
          "text": "file C:/Users/pelec/Documents/PowerSupplyModule/build/software/main.elf",
          "description": "loading elf",
          "ignoreFailures": false
        },
        {
          "text": "target remote localhost:2331",
          "description": "connect to remote",
          "ignoreFailures": false
        },
        {
          "text": "monitor reset",
          "description": "reset",
          "ignoreFailures": false
        },
        {
          "text": "load",
          "description": "load",
          "ignoreFailures": false
        },
        {
          "text": "break main",
          "description": "set breakpoint at Reset_Handler",
          "ignoreFailures": false
        }
      ],
      "targetArchitecture": "arm"
    }
  ]
}
